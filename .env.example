# =====================================================================
# CONFIGURAÇÃO DE CHAVES DE IA (OPCIONAIS)
# =====================================================================
# Se você NÃO colocar nenhuma chave, o sistema usará o motor inteligente
# de templates integrado gratuitamente e sem custos!
# =====================================================================

# 1. GROQ (Recomendada - Gratuita, ultra-rápida <0.5s por lead)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# 2. GOOGLE GEMINI (Gratuito até 1.500 requisições/dia)
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. OPENAI (GPT-4o mini)
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. DEEPSEEK
# Obtenha sua chave em: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 5. OPENROUTER (Acesso a múltiplos modelos)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =====================================================================
# SEGURANÇA DA API NO RAILWAY (RECOMENDADO PARA PRODUÇÃO)
# =====================================================================
# Defina uma senha secreta qualquer para blindar sua API.
# Apenas requisições com o header 'x-api-key' ou 'Authorization: Bearer' correto serão aceitas.
# Se deixar em branco, a API roda em modo aberto para testes.
API_SECRET_KEY=sua_chave_secreta_aqui_exemplo_abc123

